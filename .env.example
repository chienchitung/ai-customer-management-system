# ---- Browser (public, safe to expose) ----
# Leave both empty to run in local mode (data stays in this browser, no login).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Server only (Vercel env vars / .env.local; never prefix with VITE_) ----
GEMINI_API_KEY=your-gemini-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Max AI requests per user per day (default 300)
AI_DAILY_LIMIT=300
